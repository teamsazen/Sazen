---
import '../styles/studio.css';
import { developerUrl, description as defaultDescription, siteTitle } from '../data/apps';
import { gaId, githubUrl } from '../data/studio';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; type?: 'website' | 'article'; published?: string; schema?: object[]; noindex?: boolean }
const { title = siteTitle, description = defaultDescription, image = '/og.png?v=2', imageAlt = 'Sazen: apps with purpose, games with personality', type = 'website', published, schema = [], noindex = false } = Astro.props;
// Pages build to /path.html (build.format 'file') but Cloudflare serves them at /path.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, '') || '/', Astro.site);
const word = ['S', 'A', 'Z', 'E', 'N'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {import.meta.env.PROD && (
      <>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline set:html={`
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', '${gaId}');
`} />
      </>
    )}
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <!-- Google shows a favicon only at a multiple of 48 px, so the PNGs come first. -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4f2ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content="Sazen" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />
    {schema.map(data => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
    <link rel="preload" href="/fonts/anton.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/google-sans.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <script is:inline>document.documentElement.classList.add('js')</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="pill-wrap">
      <nav class="pill" aria-label="Main navigation">
        <a href="/" class="pill-brand" aria-label="Sazen home">
          <svg viewBox="0 0 600 600" aria-hidden="true"><use href="#sazen-s" width="600" height="600" /></svg>
          <span>Sazen</span>
        </a>
        <div class="pill-links"><a href={`/#studio`}>Studio</a><a href={`/#worlds`}>Apps &amp; Games</a><a href={`/#build`}>How we build</a><a href={`/blog`}>Blog</a></div>
        <a class="pill-github" href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="Sazen on GitHub (opens in a new tab)" title="Sazen on GitHub">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.105.768-.244.768-.542 0-.267-.01-.975-.015-1.913-3.13.68-3.791-1.508-3.791-1.508-.512-1.3-1.25-1.646-1.25-1.646-1.023-.7.078-.686.078-.686 1.13.08 1.725 1.16 1.725 1.16 1.005 1.723 2.637 1.225 3.28.937.103-.729.393-1.225.715-1.507-2.498-.284-5.124-1.25-5.124-5.565 0-1.23.44-2.233 1.16-3.02-.116-.285-.503-1.43.11-2.98 0 0 .945-.303 3.094 1.154a10.79 10.79 0 0 1 5.625 0c2.148-1.457 3.09-1.154 3.09-1.154.615 1.55.228 2.695.112 2.98.722.787 1.158 1.79 1.158 3.02 0 4.327-2.63 5.278-5.136 5.557.404.35.765 1.04.765 2.095 0 1.512-.014 2.732-.014 3.103 0 .3.203.652.774.541A11.252 11.252 0 0 0 12 .75Z" /></svg>
        </a>
        <a class="pill-cta" href={developerUrl} target="_blank" rel="noopener noreferrer"><svg class="play-icon" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3 2.5v19l10-9.5L3 2.5Zm1.5-1L16 8.1l-2 2.1L4.5 1.5Zm12.8 7.4 3.2 1.8c1 .6 1 2 0 2.6l-3.2 1.8L14.1 12l3.2-3.1ZM16 15.9 4.5 22.5l9.5-8.7 2 2.1Z" /></svg><span>Google Play <span aria-hidden="true">↗</span></span></a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="foot band">
      <div class="foot-top">
        <p>Independent by nature. Thoughtful by design.</p>
        <nav class="foot-links" aria-label="Footer"><a href={`/#worlds`}>Our apps</a><a href={`/blog`}>Blog</a><a href={developerUrl} target="_blank" rel="noopener noreferrer">Google Play ↗</a><a href={`/privacy`}>Website privacy</a></nav>
      </div>
      <div class="wordmark reveal-word" data-fit aria-hidden="true">{word.map(letter => <span>{letter}</span>)}</div>
      <div class="foot-bottom"><span>© {new Date().getFullYear()} Sazen. Apps &amp; Games.</span><span>Crafted With Care.</span></div>
    </footer>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="sazen-s" viewBox="-300 -300 600 600"><path d="M118.95 -300H-75A187.5 187.5 0 0 0 -75 75H75A37.5 37.5 0 0 1 75 150H-170.55A32.25 32.25 0 0 0 -170.55 214.5H-80.25A10.5 10.5 0 0 1 -80.25 235.5H-118.95A32.25 32.25 0 0 0 -118.95 300H75A187.5 187.5 0 0 0 75 -75H-75A37.5 37.5 0 0 1 -75 -150H170.55A32.25 32.25 0 0 0 170.55 -214.5H80.25A10.5 10.5 0 0 1 80.25 -235.5H118.95A32.25 32.25 0 0 0 118.95 -300Z" /><rect x="172.20" y="-300" width="90.30" height="64.50" rx="32.25" /><rect x="-262.50" y="235.50" width="90.30" height="64.50" rx="32.25" /></symbol>
    </svg>
    <script>
      import Lenis from 'lenis';
      import 'lenis/dist/lenis.css';

      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Lenis drives native scrolling, so page scripts can listen to plain `scroll` events.
      if (!reduce) {
        const lenis = new Lenis({ lerp: 0.09, anchors: { offset: -96 } });
        const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
      }

      // Size each wordmark so its letters span the full width.
      const fit = () => document.querySelectorAll<HTMLElement>('[data-fit]').forEach(el => {
        el.style.fontSize = '100px';
        const natural = [...el.children].reduce((w, c) => w + (c as HTMLElement).getBoundingClientRect().width, 0);
        el.style.fontSize = `${(el.clientWidth / natural) * 100 * 0.995}px`;
      });
      document.fonts.ready.then(fit);
      addEventListener('resize', fit);

      const io = new IntersectionObserver(entries => entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('in');
        io.unobserve(entry.target);
      }), { threshold: 0.15, rootMargin: '0px 0px -6% 0px' });
      document.querySelectorAll('.reveal, .lines, .reveal-word').forEach(el => io.observe(el));

      if (matchMedia('(pointer: fine)').matches && !reduce) document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(card => {
        card.addEventListener('pointermove', e => {
          const r = card.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          card.style.transition = 'transform .15s ease-out';
          card.style.transform = `rotateX(${-y * 7}deg) rotateY(${x * 9}deg)`;
        });
        card.addEventListener('pointerleave', () => { card.style.transition = ''; card.style.transform = ''; });
      });
    </script>
  </body>
</html>
