---
import Studio from '../../layouts/Studio.astro';
import PostCard from '../../components/PostCard.astro';
import { posts } from '../../data/blog';
import { breadcrumbs, organization, postPath } from '../../data/studio';
const FIRST = 3;
const site = Astro.site!;
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'Blog', name: 'Sazen blog', url: new URL('/blog', site).toString(), publisher: organization(site),
    blogPost: posts.map(post => ({ '@type': 'BlogPosting', headline: post.title, datePublished: post.date, url: new URL(postPath(post.slug), site).toString() })),
  },
  breadcrumbs(site, [['Sazen', '/'], ['Blog', '/blog']]),
];
---
<Studio title="Sazen Blog – Notes on Our Apps and Games" description="Short reads from the Sazen studio about Rafeeq, Quran Khatam Tracker, SalahLog, Budget AI, Exit Rush and our other apps and games." schema={schema}>
  <section class="blog-hero band">
    <a class="back reveal" href="/">← Back to Sazen</a>
    <span class="eyebrow reveal">The Sazen blog</span>
    <h1 class="display lines"><span><span>Notes from</span></span><span><span class="ghost">the studio.</span></span></h1>
    <p class="reveal">Short reads about the apps and games we make: what they are for, and how to get the most from them.</p>
  </section>
  <section class="journal band" aria-label="All posts">
    <div class="post-grid" data-posts>
      {posts.map((post, i) => <div class="post-slot" data-extra={i >= FIRST ? '' : undefined}><PostCard post={post} index={i} heading="h2" /></div>)}
    </div>
    <div class="more-wrap"><button type="button" class="btn" data-more hidden>View all {posts.length} posts</button></div>
  </section>
  <script>
    // All posts render for no-JS visitors; with JS the extras wait behind the button.
    const extras = [...document.querySelectorAll<HTMLElement>('[data-extra]')];
    const more = document.querySelector<HTMLButtonElement>('[data-more]');
    if (extras.length && more) {
      extras.forEach(el => (el.hidden = true));
      more.hidden = false;
      more.addEventListener('click', () => {
        extras.forEach((el, i) => {
          el.hidden = false;
          el.querySelector('.reveal')?.classList.add('in');
          el.animate([{ opacity: 0, transform: 'translateY(30px)' }, { opacity: 1, transform: 'none' }], { duration: 800, delay: (i % 3) * 90, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'backwards' });
        });
        more.hidden = true;
        extras[0].querySelector('a')?.focus({ preventScroll: true });
      });
    }
  </script>
</Studio>
