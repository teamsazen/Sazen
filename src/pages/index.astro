---
import Studio from '../layouts/Studio.astro';
import PhonePreview from '../components/PhonePreview.astro';
import { apps, developerUrl, icon, playUrl } from '../data/apps';
import PostCard from '../components/PostCard.astro';
import AppIndex from '../components/AppIndex.astro';
import { posts } from '../data/blog';
import { alternateNames, appPath, organization } from '../data/studio';
const start = apps.findIndex(app => app.slug === 'rafeeq');
// Coverflow placement for a slide `d` steps from the active one (kept in sync with the client script).
const place = (raw: number) => {
  const n = apps.length;
  const d = ((raw % n) + n + 3) % n - 3;
  const a = Math.min(Math.abs(d), 3);
  return { x: [0, 0.8, 1.48, 1.95][a] * Math.sign(d), ry: -Math.sign(d) * a * 10, s: [1, 0.84, 0.7, 0.6][a], o: [1, 0.92, 0.5, 0][a], z: 10 - a, far: a >= 2 };
};
const tools = apps.filter(app => app.filter !== 'games');
const games = apps.filter(app => app.filter === 'games');
const site = Astro.site!;
const schema = [
  { '@context': 'https://schema.org', ...organization(site) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Sazen', alternateName: alternateNames, url: site.toString(), publisher: organization(site) },
];
// Studio reels rendered from brand/promo; each loops on its own while on screen.
const reels = [
  { id: 'ivory', title: 'The studio reel', label: 'Sazen studio reel: all seven apps in a phone coverflow' },
  { id: 'dark', title: 'After dark', label: 'Sazen reel after dark: each app with its features' },
  { id: 'colour', title: 'In colour', label: 'Sazen reel in colour: each app in its icon colour' },
];
const marquee = ['Apps with purpose', 'Games with personality', 'Crafted with care', 'Independent by nature', 'Thoughtful by design'];
const principles = [
  ['A clear purpose', 'Why it exists', 'Every app starts with a real moment in someone’s day, and is built around it.'],
  ['A considered design', 'How it feels', 'Calm screens, clear words and details that are easy to trust.'],
  ['Worth coming back to', 'Why people return', 'An experience people return to because it helps, not because it nags.'],
  ['Independent by nature', 'Who we are', 'A small studio that chooses its own ideas and takes its time with them.'],
  ['Made for real life', 'Where it fits', 'Useful tools, quiet moments and a little play.'],
];
---
<Studio schema={schema}>
  <section class="hero" id="top">
    <div class="wrap hero-top">
      <h1 class="display hero-title">Apps with purpose.<br /><span class="ghost">Games with personality.</span></h1>
      <div class="hero-side">
        <p>An independent studio making thoughtful apps and playful escapes for Android.</p>
        <div class="actions">
          <a class="btn" href="#worlds">See the apps</a>
          <a class="btn ghost" href={developerUrl} target="_blank" rel="noopener noreferrer">Google Play <span class="ext" aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>

    <div class="show" data-show data-active={start} aria-roledescription="carousel" aria-label="Sazen apps and games">
      <div class="show-stage">
        {apps.map((app, i) => {
          const p = place(i - start);
          return (
            <div class="slide" data-i={i} data-far={p.far ? '' : undefined} style={`--x:${p.x};--ry:${p.ry}deg;--s:${p.s};--o:${p.o};z-index:${p.z}`}>
              <PhonePreview app={app} video={app.slug === 'exit-rush'} eager={!p.far} />
            </div>
          );
        })}
      </div>
      <div class="wrap show-bar">
        <div class="show-info">
          {apps.map((app, i) => (
            <a class="info" data-i={i} hidden={i !== start} href={appPath(app.slug)}>
              <img src={icon(app)} width="48" height="48" alt="" />
              <span class="info-text"><b>{app.name}</b><span>{app.headline}</span></span>
            </a>
          ))}
        </div>
        <div class="show-ctrl">
          <span class="show-count"><b data-count>0{start + 1}</b> of 0{apps.length}</span>
          <button type="button" class="round" data-prev aria-label="Previous app">←</button>
          <button type="button" class="round" data-next aria-label="Next app">→</button>
          <span class="show-progress" aria-hidden="true"><i></i></span>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee-wrap">
    <div class="marquee" aria-label={marquee.join(', ')}>
      <div class="marquee-track" aria-hidden="true">{[...marquee, ...marquee].map(item => <span>{item}</span>)}</div>
    </div>
  </div>

  <section class="catalogue" id="worlds" aria-labelledby="catalogue-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display" id="catalogue-title">Eight apps.<br /><span class="ghost">One studio.</span></h2>
        <p>From faith and reflection to a satisfying puzzle, each one is built around a moment in someone’s day.</p>
      </div>
      <AppIndex list={tools} label="Apps" />
      <AppIndex list={games} start={tools.length} label="Games" />
    </div>
  </section>

  <section class="belief" id="studio" aria-labelledby="belief-title">
    <div class="wrap">
      <figure class="belief-frame">
        <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
        <div class="belief-inner">
          <figcaption class="belief-label" id="belief-title">We believe</figcaption>
          <blockquote class="belief-quote"><p>“<b>Small moments</b> deserve a <b>clear purpose</b>, a <b>considered design</b> and an experience <b>worth coming back to.</b>”</p></blockquote>
        </div>
      </figure>
      <p class="belief-note reveal">We’re Sazen, an independent studio making apps and games for everyday life. Different ideas, one shared approach.</p>
    </div>
  </section>

  <section class="process" id="build" aria-labelledby="build-title">
    <div class="wrap process-grid">
      <div class="process-head">
        <h2 class="display" id="build-title">How we build.<br /><span class="ghost">One approach.</span></h2>
        <p>Five things every Sazen app and game is built around, from the first idea to the version on your phone.</p>
      </div>
      <ol class="steps">
        {principles.map(([title, label, text], i) => (
          <li class="step" tabindex="0">
            <span class="step-num" aria-hidden="true">0{i + 1}</span>
            <div class="step-row"><span class="step-title">{title}</span><span class="step-label">{label}</span></div>
            <div class="step-body"><p>{text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="showcase" id="collection" aria-label="Studio reels">
    <div class="wrap frames" data-reels>
      {reels.map(reel => (
        <figure class="reel reveal">
          <div class="frame">
            <video src={`/videos/sazen-reel-${reel.id}.mp4`} poster={`/images/reels/${reel.id}.webp`} width="960" height="960" muted loop playsinline preload="none" aria-label={reel.label}></video>
            <button class="reel-play" type="button" data-title={reel.title} aria-label={`Play ${reel.title}`}></button>
          </div>
        </figure>
      ))}
    </div>
  </section>

  <section class="journal" id="blog" aria-labelledby="blog-title">
    <div class="wrap">
      <div class="section-head row">
        <h2 class="display" id="blog-title">Notes from<br /><span class="ghost">the studio.</span></h2>
        <a class="btn ghost" href="/blog">All posts</a>
      </div>
      <div class="post-grid four">{posts.slice(0, 4).map((post, i) => <PostCard post={post} index={i} />)}</div>
    </div>
  </section>

  <section class="closing" aria-labelledby="closing-title">
    <div class="wrap closing-inner">
      <h2 class="display" id="closing-title">Find your next<br /><span class="ghost">everyday favourite.</span></h2>
      <a class="btn" href={developerUrl} target="_blank" rel="noopener noreferrer">Explore Sazen on Google Play <span class="ext" aria-hidden="true">↗</span></a>
    </div>
  </section>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Hero showcase: coverflow of every app, auto-advancing until the visitor takes over.
    const show = document.querySelector<HTMLElement>('[data-show]');
    if (show) {
      const slides = [...show.querySelectorAll<HTMLElement>('.slide')];
      const infos = [...show.querySelectorAll<HTMLElement>('.info')];
      const count = show.querySelector<HTMLElement>('[data-count]')!;
      const video = show.querySelector<HTMLVideoElement>('video');
      const n = slides.length;
      const DWELL = 4200;
      let active = Number(show.dataset.active);
      let timer = 0, paused = false, visible = true;

      const place = (raw: number) => {
        const d = ((raw % n) + n + 3) % n - 3;
        const a = Math.min(Math.abs(d), 3);
        return { x: [0, 0.8, 1.48, 1.95][a] * Math.sign(d), ry: -Math.sign(d) * a * 10, s: [1, 0.84, 0.7, 0.6][a], o: [1, 0.92, 0.5, 0][a], z: 10 - a, far: a >= 2 };
      };
      const syncVideo = () => {
        if (!video) return;
        const on = slides[active].contains(video) && visible && !document.hidden && !reduce;
        on ? video.play().catch(() => {}) : video.pause();
      };
      const go = (next: number) => {
        active = (next + n) % n;
        slides.forEach((slide, i) => {
          const p = place(i - active);
          slide.style.cssText = `--x:${p.x};--ry:${p.ry}deg;--s:${p.s};--o:${p.o};z-index:${p.z}`;
          slide.toggleAttribute('data-far', p.far);
          slide.classList.toggle('is-active', i === active);
        });
        infos.forEach((info, i) => (info.hidden = i !== active));
        count.textContent = String(active + 1).padStart(2, '0');
        syncVideo();
        restart();
      };
      const restart = () => {
        clearTimeout(timer);
        show.classList.remove('ticking');
        if (reduce || paused || !visible) return;
        void show.offsetWidth;
        show.classList.add('ticking');
        timer = window.setTimeout(() => go(active + 1), DWELL);
      };
      show.style.setProperty('--dwell', `${DWELL}ms`);
      show.querySelector('[data-prev]')!.addEventListener('click', () => go(active - 1));
      show.querySelector('[data-next]')!.addEventListener('click', () => go(active + 1));
      slides.forEach((slide, i) => slide.addEventListener('click', e => {
        if (i === active) return;
        e.preventDefault();
        go(i);
      }));
      show.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') { paused = true; restart(); } });
      show.addEventListener('pointerleave', () => { paused = false; restart(); });
      show.addEventListener('focusin', () => { paused = true; restart(); });
      show.addEventListener('focusout', () => { paused = false; restart(); });
      show.addEventListener('keydown', e => {
        if (e.key === 'ArrowLeft') go(active - 1);
        if (e.key === 'ArrowRight') go(active + 1);
      });
      let sx = 0, sy = 0;
      const stage = show.querySelector<HTMLElement>('.show-stage')!;
      stage.addEventListener('pointerdown', e => { sx = e.clientX; sy = e.clientY; });
      stage.addEventListener('pointerup', e => {
        const dx = e.clientX - sx;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(e.clientY - sy)) go(active + (dx < 0 ? 1 : -1));
      });
      new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; syncVideo(); restart(); }, { threshold: 0.2 }).observe(show);
      document.addEventListener('visibilitychange', syncVideo);

      go(active);
    }

    // Collection reels: each loops on its own while on screen; clicking pauses or resumes it. Reduced motion waits for a click.
    const reelWrap = document.querySelector<HTMLElement>('[data-reels]');
    if (reelWrap) {
      const reels = [...reelWrap.querySelectorAll<HTMLElement>('.reel')].map(el => ({
        el,
        video: el.querySelector('video')!,
        button: el.querySelector<HTMLButtonElement>('.reel-play')!,
        title: el.querySelector<HTMLButtonElement>('.reel-play')!.dataset.title!,
        visible: false,
        paused: reduce,
      }));
      const sync = () => {
        reels.forEach(reel => {
          const on = reel.visible && !reel.paused && !document.hidden;
          on ? reel.video.play().catch(() => {}) : reel.video.pause();
          reel.el.classList.toggle('is-paused', reel.paused);
          reel.button.setAttribute('aria-label', `${reel.paused ? 'Play' : 'Pause'} ${reel.title}`);
        });
      };
      // Start fetching just before the section arrives, so playback begins without a stall.
      new IntersectionObserver(([entry], observer) => {
        if (!entry.isIntersecting) return;
        reels.forEach(({ video }) => (video.preload = 'auto'));
        observer.disconnect();
      }, { rootMargin: '400px 0px' }).observe(reelWrap);
      const io = new IntersectionObserver(entries => {
        entries.forEach(entry => (reels.find(reel => reel.el === entry.target)!.visible = entry.isIntersecting));
        sync();
      }, { threshold: 0.25 });
      reels.forEach(reel => {
        io.observe(reel.el);
        reel.button.addEventListener('click', () => { reel.paused = !reel.paused; sync(); });
      });
      document.addEventListener('visibilitychange', sync);
    }
  </script>
</Studio>
