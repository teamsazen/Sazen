---
import Studio from '../layouts/Studio.astro';
import PhonePreview from '../components/PhonePreview.astro';
import { apps, developerUrl, icon, playUrl } from '../data/apps';
import PostCard from '../components/PostCard.astro';
import { posts } from '../data/blog';
import { appPath, organization } from '../data/studio';
const start = apps.findIndex(app => app.slug === 'rafeeq');
// Coverflow placement for a slide `d` steps from the active one (kept in sync with the client script).
const place = (raw: number) => {
  const n = apps.length;
  const d = ((raw % n) + n + 3) % n - 3;
  const a = Math.abs(d);
  return { x: [0, 0.78, 1.45, 1.9][a] * Math.sign(d), ry: -d * 16, s: [1, 0.84, 0.7, 0.6][a], o: [1, 0.92, 0.5, 0][a], z: 10 - a, far: a >= 2 };
};
const worlds = [
  { id: 'apps', label: '01 · Apps with purpose', title: 'Apps', text: 'A moment to reflect. A tool that fits your day.', list: apps.filter(app => app.filter !== 'games') },
  { id: 'games', label: '02 · Games with personality', title: 'Games', text: 'A puzzle to solve. A little play between the serious things.', list: apps.filter(app => app.filter === 'games') },
];
const site = Astro.site!;
const schema = [
  { '@context': 'https://schema.org', ...organization(site) },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'Sazen', url: site.toString(), publisher: organization(site) },
];
// Studio reels rendered from brand/promo; each loops on its own while on screen.
const reels = [
  { id: 'ivory', title: 'The studio reel', label: 'Sazen studio reel: all seven apps in a phone coverflow' },
  { id: 'dark', title: 'After dark', label: 'Sazen reel after dark: each app with its features' },
  { id: 'colour', title: 'In colour', label: 'Sazen reel in colour: each app in its icon colour' },
];
const marquee = ['Apps with purpose', 'Games with personality', 'Crafted with care', 'Independent by nature', 'Thoughtful by design'];
const principles = [
  ['A clear purpose', 'Every app starts with a real moment in someone’s day, and is built around it.'],
  ['A considered design', 'Calm screens, clear words and details that are easy to trust.'],
  ['Worth coming back to', 'An experience people return to because it helps, not because it nags.'],
  ['Independent by nature', 'A small studio that chooses its own ideas and takes its time with them.'],
  ['Made for real life', 'Useful tools, quiet moments and a little play.'],
];
---
<Studio schema={schema}>
  <section class="hero band" id="top">
    <div class="hero-top">
      <div>
        <span class="eyebrow">Independent app &amp; game studio</span>
        <h1 class="display lines"><span><span>Apps with purpose.</span></span><span><span class="ghost">Games with personality.</span></span></h1>
      </div>
      <div class="hero-side">
        <p>Thoughtful apps and playful escapes. Made with care, by Sazen.</p>
        <div class="hero-actions">
          <a class="btn" href="#worlds">Explore the studio <span aria-hidden="true">↓</span></a>
          <a class="btn ghost" href={developerUrl} target="_blank" rel="noopener noreferrer">Google Play ↗</a>
        </div>
      </div>
    </div>

    <div class="show" data-show data-active={start} aria-roledescription="carousel" aria-label="Sazen apps and games">
      <div class="show-ghost" aria-hidden="true"><span>{apps[start].name}</span></div>
      <div class="show-stage">
        {apps.map((app, i) => {
          const p = place(i - start);
          return (
            <div class="slide" data-i={i} data-far={p.far ? '' : undefined} style={`--x:${p.x};--ry:${p.ry}deg;--s:${p.s};--o:${p.o};z-index:${p.z}`}>
              <PhonePreview app={app} video={app.slug === 'exit-rush'} eager={!p.far} />
            </div>
          );
        })}
      </div>
      <div class="show-bar">
        <div class="show-info">
          {apps.map((app, i) => (
            <div class="info" data-i={i} hidden={i !== start}>
              <img src={icon(app)} width="64" height="64" alt="" />
              <div class="info-text">
                <span class="eyebrow">{app.category}</span>
                <h2>{app.name}{app.slug === '99-names' ? ' · Asmaul Husna' : ''}</h2>
                <p>{app.headline}</p>
              </div>
              <div class="info-links">
                <a class="btn" href={appPath(app.slug)}>Explore {app.name}</a>
                <a class="btn ghost" href={playUrl(app)} target="_blank" rel="noopener noreferrer">{app.slug === 'budget-ai' ? 'Check Google Play' : 'Google Play'} ↗</a>
              </div>
            </div>
          ))}
        </div>
        <div class="show-ctrl">
          <span class="show-count"><b data-count>0{start + 1}</b> / 0{apps.length}</span>
          <button type="button" class="round" data-prev aria-label="Previous app">←</button>
          <button type="button" class="round" data-next aria-label="Next app">→</button>
          <span class="show-progress" aria-hidden="true"><i></i></span>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-label={marquee.join(', ')}>
    <div class="marquee-track" aria-hidden="true">{[...marquee, ...marquee].map(item => <span>{item}</span>)}</div>
  </div>

  <section class="manifesto band" id="studio">
    <span class="eyebrow reveal">The studio behind the screens</span>
    <h2 class="display lines">
      <span><span>We’re Sazen.</span></span>
      <span><span class="ghost">Small moments.</span></span>
      <span><span>Lasting meaning.</span></span>
    </h2>
    <div class="manifesto-foot">
      <p class="reveal">An independent studio making apps and games for everyday life. From faith and reflection to a satisfying puzzle, we build around moments that matter.</p>
      <p class="reveal">Different ideas, one shared approach: a clear purpose, a considered design, and an experience worth coming back to.</p>
    </div>
  </section>

  <section class="worlds band" id="worlds" aria-label="Apps and games">
    {worlds.map(world => (
      <article class:list={['world', 'reveal', { dark: world.id === 'games' }]}>
        <svg class="world-mark" viewBox="0 0 600 600" aria-hidden="true"><use href="#sazen-s" width="600" height="600" /></svg>
        <span class="eyebrow">{world.label}</span>
        <div>
          <h3 class="display">{world.title}</h3>
          <p>{world.text}</p>
        </div>
        <ul class="app-rows">
          {world.list.map(app => (
            <li>
              <a href={appPath(app.slug)}>
                <img src={icon(app)} width="56" height="56" alt="" loading="lazy" />
                <span class="row-text"><b>{app.name}</b><small>{app.slug === '99-names' ? 'Asmaul Husna' : app.subtitle}</small></span>
                <span class="row-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section class="build" id="build" data-pin>
    <div class="build-sticky">
      <div class="build-head band">
        <h2 class="display lines"><span><span>How we</span></span><span><span>build.</span></span></h2>
        <p class="reveal">Different ideas, one shared approach. Scroll to see it.</p>
      </div>
      <div class="build-track band">
        {principles.map(([title, text], i) => (
          <article class="principle">
            <span class="num" aria-hidden="true">0{i + 1}</span>
            <div><h3>{title}</h3><p>{text}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="showcase band" id="collection">
    <div>
      <span class="eyebrow reveal">The collection</span>
      <h2 class="display lines"><span><span>Different worlds.</span></span><span><span>One studio.</span></span></h2>
    </div>
    <div class="frames" data-reels>
      {reels.map((reel, i) => (
        <figure class="reel reveal">
          <div class="frame" data-tilt>
            <video src={`/videos/sazen-reel-${reel.id}.mp4`} poster={`/images/reels/${reel.id}.webp`} width="960" height="960" muted loop playsinline preload="none" aria-label={reel.label}></video>
            <button class="reel-play" type="button" data-title={reel.title} aria-label={`Play ${reel.title}`}></button>
          </div>
          <figcaption><span class="eyebrow">{String(i + 1).padStart(2, '0')} · {reel.title}</span><span class="reel-bar" aria-hidden="true"><i></i></span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="journal band" id="blog">
    <div class="gal-head">
      <div>
        <span class="eyebrow reveal">The Sazen blog</span>
        <h2 class="display lines"><span><span>Notes from</span></span><span><span>the studio.</span></span></h2>
      </div>
      <a class="btn ghost reveal" href={`/blog`}>View all posts →</a>
    </div>
    <div class="post-grid">{posts.slice(0, 3).map((post, i) => <PostCard post={post} index={i} />)}</div>
  </section>

  <section class="cta band">
    <span class="eyebrow reveal">Apps with purpose. Games with personality.</span>
    <h2 class="display lines"><span><span>Find your next</span></span><span><span>everyday</span></span><span><span>favourite.</span></span></h2>
    <a class="btn reveal" href={developerUrl} target="_blank" rel="noopener noreferrer">Explore Sazen on Google Play ↗</a>
  </section>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Pinned horizontal scroll on wide screens; native swipe elsewhere.
    const pin = document.querySelector<HTMLElement>('[data-pin]');
    const track = pin?.querySelector<HTMLElement>('.build-track');
    const wide = matchMedia('(min-width: 900px)');
    const layoutPin = () => {
      if (!pin || !track) return;
      const on = wide.matches && !reduce;
      pin.classList.toggle('pinned', on);
      track.style.transform = '';
      pin.style.height = '';
      if (!on) return;
      const distance = track.scrollWidth + parseFloat(getComputedStyle(track).paddingLeft) - innerWidth;
      pin.style.height = `${innerHeight + Math.max(0, distance)}px`;
      pin.dataset.distance = String(Math.max(0, distance));
    };
    const movePin = () => {
      if (!pin || !track || !pin.classList.contains('pinned')) return;
      const distance = Number(pin.dataset.distance);
      const progress = Math.min(1, Math.max(0, -pin.getBoundingClientRect().top / distance || 0));
      track.style.transform = `translate3d(${-progress * distance}px,0,0)`;
    };
    document.fonts.ready.then(() => { layoutPin(); movePin(); });
    addEventListener('resize', () => { layoutPin(); movePin(); });
    wide.addEventListener('change', layoutPin);
    addEventListener('scroll', movePin, { passive: true });

    // Hero showcase: coverflow of every app, auto-advancing until the visitor takes over.
    const show = document.querySelector<HTMLElement>('[data-show]');
    if (show) {
      const slides = [...show.querySelectorAll<HTMLElement>('.slide')];
      const infos = [...show.querySelectorAll<HTMLElement>('.info')];
      const ghost = show.querySelector<HTMLElement>('.show-ghost span')!;
      const count = show.querySelector<HTMLElement>('[data-count]')!;
      const video = show.querySelector<HTMLVideoElement>('video');
      const n = slides.length;
      const DWELL = 4200;
      let active = Number(show.dataset.active);
      let timer = 0, paused = false, visible = true;

      const place = (raw: number) => {
        const d = ((raw % n) + n + 3) % n - 3;
        const a = Math.abs(d);
        return { x: [0, 0.78, 1.45, 1.9][a] * Math.sign(d), ry: -d * 16, s: [1, 0.84, 0.7, 0.6][a], o: [1, 0.92, 0.5, 0][a], z: 10 - a, far: a >= 2 };
      };
      const syncVideo = () => {
        if (!video) return;
        const on = slides[active].contains(video) && visible && !document.hidden && !reduce;
        on ? video.play().catch(() => {}) : video.pause();
      };
      const go = (next: number) => {
        active = (next + n) % n;
        slides.forEach((slide, i) => {
          const p = place(i - active);
          slide.style.cssText = `--x:${p.x};--ry:${p.ry}deg;--s:${p.s};--o:${p.o};z-index:${p.z}`;
          slide.toggleAttribute('data-far', p.far);
          slide.classList.toggle('is-active', i === active);
        });
        infos.forEach((info, i) => (info.hidden = i !== active));
        ghost.textContent = infos[active].querySelector('h2')!.textContent!.split(' · ')[0];
        if (!reduce) ghost.animate([{ opacity: 0, transform: 'translateY(12%)' }, { opacity: 1, transform: 'none' }], { duration: 900, easing: 'cubic-bezier(.16,1,.3,1)' });
        count.textContent = String(active + 1).padStart(2, '0');
        syncVideo();
        restart();
      };
      const restart = () => {
        clearTimeout(timer);
        show.classList.remove('ticking');
        if (reduce || paused || !visible) return;
        void show.offsetWidth;
        show.classList.add('ticking');
        timer = window.setTimeout(() => go(active + 1), DWELL);
      };
      show.style.setProperty('--dwell', `${DWELL}ms`);
      show.querySelector('[data-prev]')!.addEventListener('click', () => go(active - 1));
      show.querySelector('[data-next]')!.addEventListener('click', () => go(active + 1));
      slides.forEach((slide, i) => slide.addEventListener('click', e => {
        if (i === active) return;
        e.preventDefault();
        go(i);
      }));
      show.addEventListener('pointerenter', e => { if (e.pointerType === 'mouse') { paused = true; restart(); } });
      show.addEventListener('pointerleave', () => { paused = false; restart(); });
      show.addEventListener('focusin', () => { paused = true; restart(); });
      show.addEventListener('focusout', () => { paused = false; restart(); });
      show.addEventListener('keydown', e => {
        if (e.key === 'ArrowLeft') go(active - 1);
        if (e.key === 'ArrowRight') go(active + 1);
      });
      let sx = 0, sy = 0;
      const stage = show.querySelector<HTMLElement>('.show-stage')!;
      stage.addEventListener('pointerdown', e => { sx = e.clientX; sy = e.clientY; });
      stage.addEventListener('pointerup', e => {
        const dx = e.clientX - sx;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(e.clientY - sy)) go(active + (dx < 0 ? 1 : -1));
      });
      new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; syncVideo(); restart(); }, { threshold: 0.2 }).observe(show);
      document.addEventListener('visibilitychange', syncVideo);

      // A gentle lift as the showcase scrolls away.
      if (!reduce) addEventListener('scroll', () => {
        const r = show.getBoundingClientRect();
        const t = Math.min(1, Math.max(0, -r.top / r.height));
        stage.style.transform = `translateY(${t * -60}px) scale(${1 - t * 0.06})`;
      }, { passive: true });
      go(active);
    }

    // Collection reels: each loops on its own while on screen; clicking pauses or resumes it. Reduced motion waits for a click.
    const reelWrap = document.querySelector<HTMLElement>('[data-reels]');
    if (reelWrap) {
      const reels = [...reelWrap.querySelectorAll<HTMLElement>('.reel')].map(el => ({
        el,
        video: el.querySelector('video')!,
        bar: el.querySelector<HTMLElement>('.reel-bar i')!,
        button: el.querySelector<HTMLButtonElement>('.reel-play')!,
        title: el.querySelector<HTMLButtonElement>('.reel-play')!.dataset.title!,
        visible: false,
        paused: reduce,
      }));
      let frame = 0;

      const tick = () => {
        reels.forEach(({ video, bar }) => (bar.style.transform = `scaleX(${video.currentTime / video.duration || 0})`));
        frame = requestAnimationFrame(tick);
      };
      const sync = () => {
        reels.forEach(reel => {
          const on = reel.visible && !reel.paused && !document.hidden;
          on ? reel.video.play().catch(() => {}) : reel.video.pause();
          reel.el.classList.toggle('is-paused', reel.paused);
          reel.button.setAttribute('aria-label', `${reel.paused ? 'Play' : 'Pause'} ${reel.title}`);
        });
        cancelAnimationFrame(frame);
        if (reels.some(reel => reel.visible)) tick();
      };
      // Start fetching just before the section arrives, so playback begins without a stall.
      new IntersectionObserver(([entry], observer) => {
        if (!entry.isIntersecting) return;
        reels.forEach(({ video }) => (video.preload = 'auto'));
        observer.disconnect();
      }, { rootMargin: '400px 0px' }).observe(reelWrap);
      const io = new IntersectionObserver(entries => {
        entries.forEach(entry => (reels.find(reel => reel.el === entry.target)!.visible = entry.isIntersecting));
        sync();
      }, { threshold: 0.25 });
      reels.forEach(reel => {
        io.observe(reel.el);
        reel.button.addEventListener('click', () => { reel.paused = !reel.paused; sync(); });
      });
      document.addEventListener('visibilitychange', sync);
    }
  </script>
</Studio>
