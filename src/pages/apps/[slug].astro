---
import Studio from '../../layouts/Studio.astro';
import PhonePreview from '../../components/PhonePreview.astro';
import PostCard from '../../components/PostCard.astro';
import AppIndex from '../../components/AppIndex.astro';
import { apps, icon, playUrl, screen } from '../../data/apps';
import { posts } from '../../data/blog';
import { appPath, breadcrumbs, organization } from '../../data/studio';
export function getStaticPaths() { return apps.map(app => ({ params: { slug: app.slug }, props: { app } })); }
const { app } = Astro.props;
const fullName = `${app.name}${app.slug === '99-names' ? ' – Asmaul Husna' : ''}`;
const others = apps.filter(other => other.slug !== app.slug);
const external = app.website.startsWith('https');
const related = posts.filter(post => post.app === app.slug);
const site = Astro.site!;
const url = (path: string) => new URL(path, site).toString();
const category = { faith: 'LifestyleApplication', games: 'GameApplication', everyday: 'FinanceApplication', photo: 'PhotographyApplication', shopping: 'ShoppingApplication' }[app.filter];
// No offers or ratings: those would need real store data we do not publish here.
const schema = [
  {
    '@context': 'https://schema.org', '@type': 'MobileApplication', name: fullName, description: app.detail,
    operatingSystem: 'Android', applicationCategory: category, url: url(appPath(app.slug)), image: url(icon(app)),
    screenshot: [1, 2, 3].map(i => url(screen(app, i))), installUrl: playUrl(app), publisher: organization(site),
    ...(external && { sameAs: [app.website] }),
  },
  breadcrumbs(site, [['Sazen', '/'], [app.name, appPath(app.slug)]]),
];
---
<Studio title={`${app.seoTitle} · Sazen`} description={app.detail} image={`/og/apps/${app.slug}.png`} imageAlt={`${app.name}: ${app.headline}`} schema={schema}>
  <section class="ah">
    <div class="wrap">
      <a class="back" href="/#worlds">All Sazen apps</a>
      <div class="ah-grid">
        <div class="ah-copy">
          <div class="ah-id">
            <img src={icon(app)} width="72" height="72" alt={`${app.name} icon`} />
            <span><b>{app.category}</b><span>{app.slug === '99-names' ? 'Asmaul Husna' : app.subtitle}</span></span>
          </div>
          <h1 class="display">{app.name}</h1>
          <p class="ah-head">{app.headline}</p>
          <p class="ah-detail">{app.detail}</p>
          <div class="actions">
            <a class="btn" href={playUrl(app)} target="_blank" rel="noopener noreferrer">{app.slug === 'budget-ai' ? 'Check Google Play' : `Get ${app.name}`} <span class="ext" aria-hidden="true">↗</span></a>
            {external && <a class="btn ghost" href={app.website} target="_blank" rel="noopener noreferrer">Visit website <span class="ext" aria-hidden="true">↗</span></a>}
          </div>
          <p class="ah-note">{app.note}</p>
        </div>
        <div class="ah-stage" aria-label={`${app.name} screens`}>
          <div class="ah-phone left"><PhonePreview app={app} index={2} eager /></div>
          <div class="ah-phone right"><PhonePreview app={app} index={3} eager /></div>
          <div class="ah-phone center"><PhonePreview app={app} index={1} video={app.slug === 'exit-rush'} eager /></div>
        </div>
      </div>
    </div>
  </section>

  <div class="marquee-wrap">
    <div class="marquee" aria-label={app.features.join(', ')}>
      <div class="marquee-track" aria-hidden="true">{[...app.features, ...app.features, ...app.features, ...app.features].map(item => <span>{item}</span>)}</div>
    </div>
  </div>

  <section class="feat" aria-labelledby="feat-title">
    <div class="wrap process-grid">
      <div class="process-head">
        <h2 class="display" id="feat-title">Inside<br /><span class="ghost">{app.name}.</span></h2>
        <p>{app.description}</p>
      </div>
      <ol class="feat-list">
        {app.features.map((feature, i) => (
          <li><span class="step-num" aria-hidden="true">0{i + 1}</span><span class="feat-title">{feature}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="gal" aria-labelledby="gal-title">
    <div class="wrap">
      <div class="section-head row">
        <h2 class="display" id="gal-title">A closer look.</h2>
        <p>Real screens from the app. Select one to enlarge it.</p>
      </div>
      <div class="gal-row">
        {app.captions.map((caption, i) => (
          <figure class="reveal">
            <button type="button" class="shot" data-shot={i} data-caption={`${app.name}: ${caption}`} aria-label={`Enlarge screenshot: ${caption}`}>
              <PhonePreview app={app} index={i + 1} />
            </button>
            <figcaption>{caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="closing" aria-labelledby="support-title">
    <div class="wrap closing-inner">
      <h2 class="display" id="support-title">Make it part<br /><span class="ghost">of your day.</span></h2>
      <p>Find downloads, app support and the privacy information for {app.name} on Google Play{external ? ' and on its website' : ''}.</p>
      <div class="actions">
        <a class="btn" href={playUrl(app)} target="_blank" rel="noopener noreferrer">Open Google Play <span class="ext" aria-hidden="true">↗</span></a>
        {external && <a class="btn ghost" href={app.website} target="_blank" rel="noopener noreferrer">Visit website <span class="ext" aria-hidden="true">↗</span></a>}
      </div>
    </div>
  </section>

  {related.length > 0 && (
    <section class="journal" aria-labelledby="related-title">
      <div class="wrap">
        <div class="section-head row">
          <h2 class="display" id="related-title">From the blog.</h2>
          <a class="btn ghost" href="/blog">All posts</a>
        </div>
        <div class="post-grid">{related.map((post, i) => <PostCard post={post} index={i} />)}</div>
      </div>
    </section>
  )}

  <section class="catalogue more" aria-labelledby="more-title">
    <div class="wrap">
      <div class="section-head">
        <h2 class="display" id="more-title">More from Sazen.</h2>
      </div>
      <AppIndex list={others} />
    </div>
  </section>

  <dialog class="lightbox" aria-labelledby="lightbox-caption">
    <button type="button" class="round lb-close" aria-label="Close screenshot">×</button>
    <button type="button" class="round lb-prev" aria-label="Previous screenshot">←</button>
    <div class="lb-frame"></div>
    <button type="button" class="round lb-next" aria-label="Next screenshot">→</button>
    <p id="lightbox-caption"></p>
  </dialog>

  <script>
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const shots = [...document.querySelectorAll<HTMLButtonElement>('[data-shot]')];
    const dialog = document.querySelector<HTMLDialogElement>('.lightbox')!;
    const frame = dialog.querySelector<HTMLElement>('.lb-frame')!;
    const caption = dialog.querySelector<HTMLElement>('#lightbox-caption')!;
    let current = 0;
    const showShot = (i: number) => {
      current = (i + shots.length) % shots.length;
      const preview = shots[current].querySelector('.device-preview');
      if (preview) frame.replaceChildren(preview.cloneNode(true));
      caption.textContent = shots[current].dataset.caption ?? '';
    };
    shots.forEach((shot, i) => shot.addEventListener('click', () => {
      showShot(i);
      dialog.showModal();
      document.documentElement.classList.add('locked');
    }));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.querySelector('.lb-prev')!.addEventListener('click', () => showShot(current - 1));
    dialog.querySelector('.lb-next')!.addEventListener('click', () => showShot(current + 1));
    dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('keydown', e => {
      if (e.key === 'ArrowLeft') showShot(current - 1);
      if (e.key === 'ArrowRight') showShot(current + 1);
    });
    dialog.addEventListener('close', () => document.documentElement.classList.remove('locked'));

    const video = document.querySelector<HTMLVideoElement>('.ah-stage video');
    if (video) {
      let visible = false;
      const sync = () => (visible && !reduce && !document.hidden ? video.play().catch(() => {}) : video.pause());
      new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }, { threshold: 0.2 }).observe(video);
      document.addEventListener('visibilitychange', sync);
    }

  </script>
</Studio>
